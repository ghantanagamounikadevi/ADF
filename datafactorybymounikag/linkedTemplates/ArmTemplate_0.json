					"location": {
						"type": "AzureBlobStorageLocation",
						"fileName": {
							"value": "\n",
							"type": "Expression"
						},
						"folderPath": {
							"value": "Empjson@{formatDateTime(convertTimeZone(utcNow(),'UTC','Central Standard Time'),'yyyyMMdd')}/Emp_@{formatDateTime(convertTimeZone(utcNow(),'UTC','Central Standard Time'),'yyyyMMdd_HHmmss')}.json",
							"type": "Expression"
