{
	"name": "dataflow2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				}
			],
			"scriptLines": [
				"source(output(",
				"          empid as integer,",
				"          ename as string,",
				"          sal as integer,",
				"          dept_no as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          emp_id as integer,",
				"          ename as string,",
				"          sal as integer,",
				"          dept_no as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source1, source2 join(empid == emp_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 derive(MD5_Source = md5(source1@ename+toString(source1@sal)+toString(source1@dept_no)),",
				"          MD5_Traget = md5(source2@ename+toString(source2@sal)+toString(source2@dept_no))) ~> derivedColumn1",
				"derivedColumn1 derive(Flag = iif(isNull(emp_id),'INSERT',toString(iif(!isNull(emp_id) && MD5_Source !=MD5_Traget,'UPDATE',toString(0))))\r",
				") ~> derivedColumn2",
				"derivedColumn2 split(Flag=='INSERT',",
				"     Flag=='UPDATE',",
				"     disjoint: true) ~> split1@(Insert, Update, Default)",
				"split1@Update derive(startdate = currentDate(),",
				"          enddate = toDate('12-31-9999','MM-dd-yyyy')) ~> derivedColumn3",
				"split1@Insert derive(startdate = currentDate(),",
				"          enddate = toDate('12-31-9999','mm-dd-yyyy')) ~> derivedColumn4",
				"derivedColumn4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}