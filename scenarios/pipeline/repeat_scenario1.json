						"type": "DatasetReference",
						"parameters": {
							"param_container": "sales",
							"param_folder": "snowflake_source",
							"param_file": "emp_fromsnowflake.csv"
						}
					}
				]
			}
		],
		"folder": {
			"name": "Practicescenarios"
		},
		"annotations": []
	}
