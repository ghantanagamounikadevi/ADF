				},
				"inputs": [
					{
						"referenceName": "snowflakeDS",
						"type": "DatasetReference",
						"parameters": {
							"p_table": "EMP"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "Json1_target",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": []
	}
}